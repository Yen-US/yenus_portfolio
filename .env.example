# OpenAI API Key for AI Summary feature
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Resend transactional email for discovery requests
# Verify yenus.dev in Resend before using this sender in production.
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=Yenson Umana <discovery@yenus.dev>
DISCOVERY_NOTIFICATION_EMAIL=yen21000@gmail.com
NEXT_PUBLIC_SITE_URL=https://yenus.dev

# Static Google Meet or Zoom URL included in every confirmed calendar event.
DISCOVERY_MEETING_URL=https://meet.google.com/your-meeting-room

# Signal Room server-only persistence
# Run docs/supabase-signal-room.sql in the Supabase SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Signal Room model overrides
OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview
OPENAI_RESEARCH_MODEL=gpt-5-mini
